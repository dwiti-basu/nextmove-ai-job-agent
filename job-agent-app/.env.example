# Copy to .env.local for local dev. In production, set these in
# Vercel: Project → Settings → Environment Variables.

# aistudio.google.com/apikey — free tier, no credit card.
GEMINI_API_KEY=

# Your Supabase project: Settings → API
# NEXT_PUBLIC_ ones are safe to expose to the browser — they're how sign-in works.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# service_role key — NEVER exposed to the browser, used only by the shared scanner.
SUPABASE_SERVICE_KEY=

# Any random long string you make up — protects /api/cron from
# being triggered by anyone who finds the URL.
CRON_SECRET=

# Widens job scanning across the whole web, not a fixed company list.
# console.cloud.google.com -> enable "Custom Search API" -> create API key
# programmablesearchengine.google.com -> create a search engine -> "Search the entire web"
# Free tier: 100 queries/day.
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_CX=
